<%# views/partials/header.ejs
    The top of every page. A "partial" is a piece of a page that is reused.
    Each page starts with:  include('partials/header', { title: '...' })
    and passes in its own title. %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <%# Makes the page fit the width of the device it is shown on %>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%# Tells the browser this site supports both light and dark mode %>
  <meta name="color-scheme" content="light dark">
  <title><%= title %> | Bootcamp Connect</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%# Lets keyboard users jump straight past the navigation %>
  <a class="skip-link" href="#main">Skip to main content</a>

  <header class="site-header">
    <div class="container">
      <a class="site-name" href="/">Bootcamp Connect</a>

      <%# The links change with who is looking. currentUser is set for every
          page by loadCurrentUser in middleware/auth.js: it is the logged-in
          user, or null when nobody is logged in.
          aria-label names this group of links for screen readers. %>
      <nav class="site-nav" aria-label="Main">
        <% if (currentUser) { %>
          <span class="site-nav-name"><%= currentUser.name %></span>
          <%# The user's own profile page (feature 02). It is inside this
              "if", so it only shows when someone is logged in. %>
          <a href="/profile/<%= currentUser.id %>">My profile</a>
          <%# Added by Koulla with Walied's agreement (final live check #20):
              the Connections page (feature 04) and the Account page
              (feature 06). Also inside the "if", so logged-in users only. %>
          <a href="/connections">Connections</a>
          <a href="/account">Account</a>
          <%# Only admins see the link to the admin pages %>
          <% if (currentUser.is_admin === 1) { %>
            <a href="/admin">Admin</a>
          <% } %>
          <%# Logging out is a form, not a link, because it must be a POST
              request (see the logout route in routes/auth.js) %>
          <form method="post" action="/logout">
            <button type="submit" class="link-button">Log out</button>
          </form>
        <% } else { %>
          <a href="/login">Log in</a>
          <a href="/register">Register</a>
        <% } %>
      </nav>
    </div>
  </header>

  <main id="main" class="container">
