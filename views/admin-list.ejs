<%# views/admin-list.ejs
    One admin list page, such as Courses or Interests. The same page is
    used for every list. routes/admin.js passes in:
      list    the list's settings from LISTS (title, path, singular)
      rows    the entries, each with an id and a name
      errors  messages to show when an add or remove was refused
      value   what the admin typed last time, so the add form can be refilled %>
<%- include('partials/header', { title: list.title }) %>

<p><a href="/admin">&larr; Admin</a></p>

<h1><%= list.title %></h1>

<%# role="alert" makes a screen reader read the box out straight away %>
<% if (errors.length > 0) { %>
  <div class="error-box" role="alert">
    <p>That did not work:</p>
    <ul>
      <% errors.forEach((error) => { %>
        <li><%= error %></li>
      <% }) %>
    </ul>
  </div>
<% } %>

<%# The add form sends the new name to POST /admin/<list path> %>
<form method="post" action="/admin/<%= list.path %>" class="form admin-add">
  <div class="form-field">
    <label for="name">New <%= list.singular %></label>
    <input type="text" id="name" name="name" value="<%= value %>" maxlength="100" required>
  </div>
  <button type="submit" class="button">Add</button>
</form>

<% if (rows.length === 0) { %>
  <p class="notice">There are no <%= list.title.toLowerCase() %> yet.</p>
<% } else { %>
  <ul class="admin-rows">
    <% for (const row of rows) { %>
      <li>
        <span><%= row.name %></span>
        <%# Removing is a form with a button, because it changes data
            (see the remove route in routes/admin.js).
            aria-label gives screen readers the full meaning, "Remove Fintech",
            since every button on its own just says "Remove". %>
        <form method="post" action="/admin/<%= list.path %>/<%= row.id %>/remove">
          <button type="submit" class="link-button" aria-label="Remove <%= row.name %>">Remove</button>
        </form>
      </li>
    <% } %>
  </ul>
<% } %>

<%- include('partials/footer') %>
