<%# views/conversation.ejs
    One conversation, at /conversations/:id. routes/connections.js passes in:
      conversationId  the accepted request's id number
      otherPerson     the other person in it (id, name)
      messages        oldest first: body, senderName, time (UK time) and
                      created_at (the time as saved, in UTC)
      errors          messages to show when a message was refused
      draft           the refused text, put back in the box
    The route has already checked that the logged-in user is one of the two
    people, so this page never has to. %>

<%- include('partials/header', { title: 'Conversation with ' + otherPerson.name }) %>

<h1>Conversation with <a href="/profile/<%= otherPerson.id %>"><%= otherPerson.name %></a></h1>

<p><a href="/connections">Back to my connections</a></p>

<% if (messages.length === 0) { %>
  <p>No messages yet. Say hello!</p>
<% } else { %>
  <%# ol is a numbered list: the right tag for messages in order %>
  <ol class="message-list">
    <% for (const message of messages) { %>
      <li class="message">
        <p class="message-meta">
          <strong><%= message.senderName %></strong>
          <%# datetime gives the exact time in a standard form for
              computers; the text inside is for people %>
          <time datetime="<%= message.created_at.replace(' ', 'T') %>Z"><%= message.time %></time>
        </p>
        <%# "print with =" shows the message as plain text, so anything a
            user typed, even HTML, is never run as code %>
        <p class="message-body"><%= message.body %></p>
      </li>
    <% } %>
  </ol>
<% } %>

<%# Problems with a refused message. role="alert" makes a screen reader
    read the box out straight away. %>
<% if (errors.length > 0) { %>
  <div class="error-box" role="alert">
    <ul>
      <% errors.forEach((error) => { %>
        <li><%= error %></li>
      <% }) %>
    </ul>
  </div>
<% } %>

<%# The box for a new message. maxlength stops the browser accepting more
    than 500 characters; the server checks again, because a browser can be
    bypassed. draft is the refused text, put back so it is not lost. It goes
    BETWEEN the textarea tags on one line, so no extra spaces sneak in. %>
<form method="post" action="/conversations/<%= conversationId %>" class="form">
  <div class="form-field">
    <label for="message">Your message</label>
    <p class="hint" id="message-hint">Up to 500 characters. Refresh the page to see new replies.</p>
    <textarea id="message" name="message" maxlength="500" rows="3" aria-describedby="message-hint"><%= draft %></textarea>
  </div>
  <button type="submit" class="button">Send</button>
</form>

<%- include('partials/footer') %>
