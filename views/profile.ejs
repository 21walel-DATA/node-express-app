<%# views/profile.ejs
    One person's profile page, at /profile/:id. routes/profile.js passes in
    "profile" (the person, or null when there is nothing to show) and, when
    there is a profile, the lists of ticks.
    The email address is never passed in, so it can never appear here.
    The "print with =" EJS tag turns characters like < into safe text, so
    whatever a user typed is shown, never run as code. %>

<% if (!profile) { %>
  <%# Nobody has this id, or their setup is not finished %>
  <%- include('partials/header', { title: 'Profile not found' }) %>

  <h1>Profile not found</h1>
  <p>There is no profile at this address.</p>
  <p><a href="/">Back to your matches</a></p>

<% } else { %>
  <%- include('partials/header', { title: profile.name }) %>

  <div class="profile-heading">
    <%# The coloured circle. aria-hidden hides it from screen readers,
        because the name straight after it already says the same thing.
        circleColour is 1 to 5, picked from the person's id, and the
        colour-1 to colour-5 classes in style.css give the colours. %>
    <%# Feature 07: show the photo when there is one, otherwise the circle.
        alt="" for the same reason as aria-hidden on the circle: the name
        straight after it already says who this is. %>
    <% if (profile.photo_filename) { %>
      <img class="profile-photo" src="/photos/<%= profile.photo_filename %>" alt="">
    <% } else { %>
      <span class="initials colour-<%= circleColour %>" aria-hidden="true"><%= initials %></span>
    <% } %>
    <div>
      <h1><%= profile.name %></h1>
      <%# A user may have no course; show it only when there is one %>
      <% if (profile.course) { %>
        <p class="profile-course"><%= profile.course %></p>
      <% } %>
    </div>
  </div>

  <% if (isOwnProfile) { %>
    <%# Only on your own page. The form always edits the logged-in user. %>
    <p>
      <a href="/profile/edit">Edit my profile</a>
      <%# Feature 07: the photo upload page %>
      &middot; <a href="/photo"><%= profile.photo_filename ? 'Change photo' : 'Add a photo' %></a>
    </p>
  <% } %>

  <%# The bio and business idea are optional, so show each only if filled in.
      The profile-text class keeps the line breaks the person typed. %>
  <% if (profile.bio) { %>
    <h2>About me</h2>
    <p class="profile-text"><%= profile.bio %></p>
  <% } %>

  <% if (profile.business_idea) { %>
    <h2>Business idea</h2>
    <p class="profile-text"><%= profile.business_idea %></p>
  <% } %>

  <%# Every list of ticks below uses the tag-list class, which shows each
      tick as a small rounded tag in a row instead of a bullet point %>
  <h2>Looking for</h2>
  <% if (lookingFor.length === 0) { %>
    <p>Nothing ticked yet.</p>
  <% } else { %>
    <ul class="tag-list">
      <% for (const label of lookingFor) { %>
        <li><%= label %></li>
      <% } %>
    </ul>
  <% } %>

  <%# Skills come in groups: one heading per category, then its skills.
      Each skill has an id and a name; only the name is shown. %>
  <h2>Has these skills</h2>
  <% if (skillsHas.length === 0) { %>
    <p>Nothing ticked yet.</p>
  <% } else { %>
    <% for (const group of skillsHas) { %>
      <h3 class="category-heading"><%= group.category %></h3>
      <ul class="tag-list">
        <% for (const skill of group.skills) { %>
          <li><%= skill.name %></li>
        <% } %>
      </ul>
    <% } %>
  <% } %>

  <h2>Looking for these skills</h2>
  <% if (skillsWants.length === 0) { %>
    <p>Nothing ticked yet.</p>
  <% } else { %>
    <% for (const group of skillsWants) { %>
      <h3 class="category-heading"><%= group.category %></h3>
      <ul class="tag-list">
        <% for (const skill of group.skills) { %>
          <li><%= skill.name %></li>
        <% } %>
      </ul>
    <% } %>
  <% } %>

  <h2>Interests</h2>
  <% if (interests.length === 0) { %>
    <p>Nothing ticked yet.</p>
  <% } else { %>
    <ul class="tag-list">
      <% for (const interest of interests) { %>
        <li><%= interest %></li>
      <% } %>
    </ul>
  <% } %>

<% } %>

<%- include('partials/footer') %>
